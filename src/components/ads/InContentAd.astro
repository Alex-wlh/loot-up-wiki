---
/**
 * InContentAd — a page-internal ad slot (e.g. between article sections).
 *
 * Uses the active Adsterra Native Banner first. A configured AdSense unit is
 * the fallback while Adsterra is absent. Empty variables leave the page
 * unchanged.
 *
 * Unlike StickyBanner, this is not sticky; it sits inline with content.
 */
import AdSenseSlot from './AdSenseSlot.astro';
import AdsterraNative from './AdsterraNative.astro';
import { getUi } from '~/i18n/ui';
import { isLocale } from '~/i18n/routing';

interface Props {
  /** Optional label override above the ad (for disclosure). */
  label?: string;
}

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT_INCONTENT as string | undefined;
const adsterraScript = import.meta.env.PUBLIC_ADSTERRA_NATIVE_SCRIPT as string | undefined;
const adsterraContainer = import.meta.env.PUBLIC_ADSTERRA_NATIVE_CONTAINER_ID as string | undefined;
const showAdsterra = !!(adsterraScript && adsterraContainer);
const showAdSense = !showAdsterra && !!(client && slot);
const show = showAdSense || showAdsterra;
const current = Astro.currentLocale;
const sharedStrings =
  current && isLocale(current)
    ? ((getUi(current).shared ?? {}) as unknown as Record<string, string>)
    : {};
const { label = sharedStrings.adLabel ?? 'Advertisement' } = Astro.props;
---
{show && (
  <div class:list={['my-8 flex flex-col items-center justify-center', showAdSense ? 'min-h-[250px]' : 'min-h-[90px]']}>
    <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{label}</span>
    {showAdSense ? <AdSenseSlot position="incontent" /> : <AdsterraNative />}
  </div>
)}
